# Copy this file to .env and fill in your values.

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- PostgreSQL (must have the pgvector extension available) ---
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
LORERAVEN_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/loreraven

# --- Optional overrides ---
# LORERAVEN_CHAT_MODEL=gpt-4o-mini
# LORERAVEN_TABLE=loreraven
# LORERAVEN_REPO_DIR=.loreraven/repo

# Chunks retrieved per question. Higher means more context and a bigger prompt bill.
# LORERAVEN_TOP_K=4
